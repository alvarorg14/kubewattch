{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {"type":"object", "required":["repository","tag","pullPolicy"], "properties":{"repository":{"type":"string","minLength":1},"tag":{"type":"string"},"pullPolicy":{"enum":["Always","IfNotPresent","Never"]}}},
    "resources": {"type":"object"},
    "leaderElection": {"type":"object", "required":["enabled"], "properties":{"enabled":{"type":"boolean"}}},
    "metrics": {"type":"object", "required":["servingCertSecret","serviceMonitor"], "properties":{
      "servingCertSecret":{"type":"string"},
      "serviceMonitor":{"type":"object", "required":["enabled","labels","caSecretName","caSecretKey","prometheusServiceAccount"], "properties":{
        "enabled":{"type":"boolean"},"labels":{"type":"object","additionalProperties":{"type":"string"}},"caSecretName":{"type":"string"},"caSecretKey":{"type":"string","minLength":1},
        "prometheusServiceAccount":{"type":"object","required":["name","namespace"],"properties":{"name":{"type":"string"},"namespace":{"type":"string"}}}
      }}
    }}
  },
  "required": ["image", "resources", "leaderElection", "metrics"]
}
