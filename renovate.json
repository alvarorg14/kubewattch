{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Madrid",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 10,
  "automerge": false,
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "labels": [
        "dependencies"
      ]
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "labels": [
        "dependencies"
      ]
    },
    {
      "matchManagers": [
        "github-actions",
        "custom.regex"
      ],
      "labels": [
        "ci"
      ]
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Go dependencies"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "k8s.io/api",
        "k8s.io/apimachinery",
        "k8s.io/client-go",
        "sigs.k8s.io/controller-runtime"
      ],
      "groupName": "Kubernetes stack",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "Docker base images"
    },
    {
      "matchManagers": [
        "github-actions",
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "CI dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/",
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+ \\?= (?<currentValue>\\S+)"
      ]
    }
  ]
}
